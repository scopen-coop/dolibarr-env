#!/usr/bin/env bash
set -euo pipefail

# --- Configuration & Globals ---
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${ROOT_DIR}/docker/compose.yml"
CLIENTS_DIR="${ROOT_DIR}/clients"
CORES_DIR="${ROOT_DIR}/cores"
DOLIBARR_SOURCE_DIR="${ROOT_DIR}/dolibarr-source"
SANITIZE_SQL_FILE="${ROOT_DIR}/database/sanitize.sql"

# Colors
export LC_ALL=C.UTF-8
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# --- Utilities ---
log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }
log_step()    { echo -e "${PURPLE}➜${NC} $1"; }

usage() {
  echo -e "${CYAN}Dolibarr Docker Client Manager${NC}"
  echo "Usage:"
  echo "  ./client list                        List all clients"
  echo "  ./client create [name] [ver] [img]   Create a new client (interactive if args missing)"
  echo "  ./client up <client>                 Start a client"
  echo "  ./client down <client> [--volumes]   Stop a client"
  echo "  ./client restart <client>            Restart a client"
  echo "  ./client status [client]             Show status of one or all clients"
  echo "  ./client logs <client>               Show logs"
  echo "  ./client shell <client>              Open a shell in the PHP container"
  echo "  ./client restore <client> [dump]     Restore a database dump"
  echo "  ./client sanitize <client>           Apply sanitize SQL to client database"
  echo "  ./client url <client>                Show client URL"
  echo "  ./client hosts <client>              Show command to update /etc/hosts"
  echo "  ./client build <client>              Rebuild client image"
  echo "  ./client self-update [--dry-run]     Update manager repo, Dolibarr source and core worktrees"
  exit 1
}

need_client_env() {
  local client="$1"
  local env_file="${CLIENTS_DIR}/${client}/.env"
  if [[ ! -f "${env_file}" ]]; then
    log_error "Client '${client}' not found (missing .env in ${env_file})"
  fi
  echo "${env_file}"
}

dc() {
  local client="$1"
  local env_file
  env_file="$(need_client_env "${client}")"
  shift
  # Retrieve PROJECT from .env
  local project
  local php_image
  local normalized_php_image
  project=$(grep -E '^PROJECT=' "${env_file}" | cut -d= -f2)
  php_image=$(grep -E '^PHP_IMAGE=' "${env_file}" | cut -d= -f2-)
  normalized_php_image="$(normalize_php_image "${php_image}")"

  if [[ -n "${php_image}" && "${normalized_php_image}" != "${php_image}" ]]; then
    log_warn "PHP image '${php_image}' is unavailable. Using '${normalized_php_image}' for this run."
  fi

  PHP_IMAGE="${normalized_php_image:-${php_image}}" \
    docker compose -f "${COMPOSE_FILE}" --env-file "${env_file}" -p "${project}" "$@"
}

db_up() {
  log_info "Ensuring shared database is up..."
  docker compose -f "${ROOT_DIR}/database/compose.yml" up -d
}

reverse_proxy_up() {
  log_info "Ensuring reverse proxy is up..."
  docker compose -f "${ROOT_DIR}/reverse-proxy/compose.yml" up -d
}

shared_infra_up() {
  reverse_proxy_up
  db_up
}

db_exec() {
  docker exec -i dolibarr-db mariadb "$@"
}

# Keep the MariaDB account in sync with the client .env.
# CREATE USER IF NOT EXISTS does not update an existing password, so restore
# would fail with ERROR 1045 when .env was regenerated after the user existed.
ensure_client_db() {
  local db_name="$1"
  local db_user="$2"
  local db_pass="$3"
  local db_root_pass="${4:-root}"

  db_exec -uroot -p"${db_root_pass}" <<EOSQL
CREATE DATABASE IF NOT EXISTS \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${db_user}'@'%' IDENTIFIED BY '${db_pass}';
CREATE USER IF NOT EXISTS '${db_user}'@'localhost' IDENTIFIED BY '${db_pass}';
ALTER USER '${db_user}'@'%' IDENTIFIED BY '${db_pass}';
ALTER USER '${db_user}'@'localhost' IDENTIFIED BY '${db_pass}';
GRANT ALL PRIVILEGES ON \`${db_name}\`.* TO '${db_user}'@'%';
GRANT ALL PRIVILEGES ON \`${db_name}\`.* TO '${db_user}'@'localhost';
FLUSH PRIVILEGES;
EOSQL
}

apply_sanitize_sql() {
  local sql_file="${SANITIZE_SQL_FILE}"

  [[ -f "${sql_file}" ]] || log_error "Sanitize SQL file not found: ${sql_file}"

  log_info "Applying sanitize SQL: ${sql_file}"
  db_exec -uroot -p"${DB_ROOT_PASS:-root}" "${DB_NAME}" < "${sql_file}"
}

ensure_documents_seeded() {
  local client="$1"
  local client_dir="${CLIENTS_DIR}/${client}"
  local seed_dir="${ROOT_DIR}/dolibarrDocumentDefault/documents"

  if [[ ! -d "${seed_dir}" ]]; then
    log_warn "Seed documents not found at ${seed_dir} (skip)."
    return
  fi

  mkdir -p "${client_dir}/documents"

  # Keep bind-mounted documents writable by both host user and container www-data.
  # Must run before rsync so existing container-owned dirs can have subdirs created inside them.
  chmod -R a+rwX "${client_dir}/documents" 2>/dev/null || true

  if command -v rsync >/dev/null 2>&1; then
    # Avoid metadata updates that commonly fail on bind-mounted client documents.
    rsync -a --no-owner --no-group --no-perms --no-times --omit-dir-times --ignore-existing "${seed_dir}/" "${client_dir}/documents/"
  else
    # Best effort fallback without overwriting existing files
    cp -a -n "${seed_dir}/." "${client_dir}/documents/" 2>/dev/null || true
  fi
}

sanitize_conf_for_install() {
  local client="$1"
  local client_dir="${CLIENTS_DIR}/${client}"
  local conf_file="${client_dir}/conf/conf.php"
  local lock_file="${client_dir}/documents/install.lock"

  # If installation is finished, never touch conf.php automatically.
  [[ -f "${lock_file}" ]] && return 0
  if [[ -f "${conf_file}" ]]; then
    # Broken or partial conf.php files can trap installer into a bad state.
    if ! rg -q '\$dolibarr_main_db_host' "${conf_file}"; then
      local backup="${conf_file}.broken.$(date +%Y%m%d%H%M%S)"
      mv "${conf_file}" "${backup}"
      log_warn "Detected invalid conf.php for '${client}'. Moved to ${backup}"
    else
      # Valid conf.php exists; keep it.
      return 0
    fi
  fi

  # Keep conf.php absent so Dolibarr redirects to installer.
  rm -f "${conf_file}"
}

client_url() {
  local client="$1"
  local env_file="${CLIENTS_DIR}/${client}/.env"
  if [[ ! -f "${env_file}" ]]; then return; fi
  local vhost
  vhost="$(grep -E '^VHOST=' "${env_file}" | cut -d= -f2)"
  echo "http://${vhost}/"
}

generate_install_forced_php() {
  local client="$1"
  local env_file="${CLIENTS_DIR}/${client}/.env"
  local client_dir="${CLIENTS_DIR}/${client}"

  [[ -f "${env_file}" ]] || log_error "Client '${client}' not found (missing .env)"

  local db_name db_user db_pass
  db_name="$(grep -E '^DB_NAME=' "${env_file}" | cut -d= -f2)"
  db_user="$(grep -E '^DB_USER=' "${env_file}" | cut -d= -f2)"
  db_pass="$(grep -E '^DB_PASS=' "${env_file}" | cut -d= -f2)"

  cat <<EOF > "${client_dir}/conf/install.forced.php"
<?php
// Generated by client script (per-client Dolibarr install defaults).
// Use mode 2 so step1 reads real values from this file (not masked stars from the form).
\$force_install_noedit = 2;
\$force_install_type = 'mysqli';
\$force_install_dbserver = 'dolibarr-db';
\$force_install_port = '3306';
\$force_install_database = '${db_name}';
\$force_install_prefix = 'llx_';
\$force_install_createdatabase = '0';
\$force_install_databaselogin = '${db_user}';
\$force_install_databasepass = '${db_pass}';
\$force_install_createuser = '0';
\$force_install_main_data_root = '/var/www/html/documents';
EOF
  chmod 664 "${client_dir}/conf/install.forced.php"
}

generate_conf_php() {
  local client="$1"
  local env_file="${CLIENTS_DIR}/${client}/.env"
  local client_dir="${CLIENTS_DIR}/${client}"

  [[ -f "${env_file}" ]] || log_error "Client '${client}' not found (missing .env)"

  local vhost db_name db_user db_pass
  vhost="$(grep -E '^VHOST=' "${env_file}" | cut -d= -f2)"
  db_name="$(grep -E '^DB_NAME=' "${env_file}" | cut -d= -f2)"
  db_user="$(grep -E '^DB_USER=' "${env_file}" | cut -d= -f2)"
  db_pass="$(grep -E '^DB_PASS=' "${env_file}" | cut -d= -f2)"

  rm -f "${client_dir}/conf/conf.php"
  cat <<EOF > "${client_dir}/conf/conf.php"
<?php
// Generated by client script
\$dolibarr_main_url_root='https://${vhost}';
\$dolibarr_main_force_https=1;
\$dolibarr_main_document_root='/var/www/html';
\$dolibarr_main_url_root_alt='/custom';
\$dolibarr_main_document_root_alt='/var/www/html/custom';
\$dolibarr_main_data_root='/var/www/html/documents';
\$dolibarr_main_db_host='dolibarr-db';
\$dolibarr_main_db_user='${db_user}';
\$dolibarr_main_db_pass='${db_pass}';
\$dolibarr_main_db_name='${db_name}';
EOF
  chmod 666 "${client_dir}/conf/conf.php"
}

get_available_versions() {
  ls -1 "${CORES_DIR}" | grep "dolibarr-" | sed 's/dolibarr-//' | sort -V
}

default_php_image_for_version() {
  local php_ver="$1"

  case "${php_ver}" in
    7.4|8.0|8.1)
      echo "php:${php_ver}-fpm-bullseye"
      ;;
    *)
      echo "php:${php_ver}-fpm-bookworm"
      ;;
  esac
}

normalize_php_image() {
  local php_image="$1"

  case "${php_image}" in
    php:7.4-fpm-bookworm|php:8.0-fpm-bookworm|php:8.1-fpm-bookworm)
      local php_ver
      php_ver="${php_image#php:}"
      php_ver="${php_ver%-fpm-bookworm}"
      default_php_image_for_version "${php_ver}"
      ;;
    *)
      echo "${php_image}"
      ;;
  esac
}

update_hosts() {
  local vhost="$1"
  if grep -qE "\s${vhost}$" /etc/hosts; then
    log_info "Host '${vhost}' already exists in /etc/hosts."
  else
    log_step "Adding '${vhost}' to /etc/hosts (requires sudo)..."
    echo "127.0.0.1 ${vhost}" | sudo tee -a /etc/hosts > /dev/null
    log_success "Hosts updated."
  fi
}

relpath() {
  local path="$1"

  if [[ "${path}" == "${ROOT_DIR}" ]]; then
    echo "."
  elif [[ "${path}" == "${ROOT_DIR}/"* ]]; then
    echo "${path#"${ROOT_DIR}/"}"
  else
    echo "${path}"
  fi
}

SELF_UPDATE_DRY_RUN=0
SELF_UPDATE_FAILURES=0

run_or_dry() {
  if [[ "${SELF_UPDATE_DRY_RUN}" == "1" ]]; then
    printf "%b[DRY-RUN]%b" "${CYAN}" "${NC}"
    printf " %q" "$@"
    printf "\n"
    return 0
  fi

  "$@"
}

git_current_branch() {
  local repo="$1"
  git -C "${repo}" symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

git_upstream() {
  local repo="$1"
  git -C "${repo}" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true
}

git_tracked_changes() {
  local repo="$1"
  git -C "${repo}" status --porcelain --untracked-files=no
}

record_self_update_failure() {
  SELF_UPDATE_FAILURES=$((SELF_UPDATE_FAILURES + 1))
}

update_git_branch_repo() {
  local repo="$1"
  local label="$2"
  local branch
  local upstream

  if [[ ! -d "${repo}" ]] || ! git -C "${repo}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log_warn "${label} is not a Git worktree, skipping."
    record_self_update_failure
    return 0
  fi

  branch="$(git_current_branch "${repo}")"
  if [[ -z "${branch}" ]]; then
    log_warn "${label} is on a detached HEAD, skipping branch pull."
    record_self_update_failure
    return 0
  fi

  upstream="$(git_upstream "${repo}")"
  if [[ -z "${upstream}" ]]; then
    log_warn "${label} branch '${branch}' has no upstream, skipping."
    record_self_update_failure
    return 0
  fi

  log_step "Updating ${label} (${branch} <- ${upstream})"
  if ! run_or_dry git -C "${repo}" pull --ff-only --autostash --prune; then
    log_warn "Could not update ${label}. Resolve the Git issue above, then rerun self-update."
    record_self_update_failure
  fi
}

update_manager_repository() {
  update_git_branch_repo "${ROOT_DIR}" "client manager"

  log_step "Synchronizing Dolibarr submodule"
  if ! run_or_dry git -C "${ROOT_DIR}" submodule sync --recursive; then
    log_warn "Could not sync submodules."
    record_self_update_failure
  fi
  if ! run_or_dry git -C "${ROOT_DIR}" submodule update --init --recursive; then
    log_warn "Could not initialize/update submodules."
    record_self_update_failure
  fi
}

update_dolibarr_source() {
  local branch
  local remote_head

  if [[ ! -d "${DOLIBARR_SOURCE_DIR}" ]] || ! git -C "${DOLIBARR_SOURCE_DIR}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log_warn "dolibarr-source is not initialized. Run: git submodule update --init --recursive"
    record_self_update_failure
    return 0
  fi

  log_step "Fetching Dolibarr remotes"
  if ! run_or_dry git -C "${DOLIBARR_SOURCE_DIR}" fetch --all --prune; then
    log_warn "Could not fetch Dolibarr remotes."
    record_self_update_failure
    return 0
  fi

  branch="$(git_current_branch "${DOLIBARR_SOURCE_DIR}")"
  if [[ -n "${branch}" ]]; then
    update_git_branch_repo "${DOLIBARR_SOURCE_DIR}" "dolibarr-source"
    return 0
  fi

  remote_head="$(git -C "${DOLIBARR_SOURCE_DIR}" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  remote_head="${remote_head:-origin/develop}"

  if [[ -n "$(git_tracked_changes "${DOLIBARR_SOURCE_DIR}")" ]]; then
    if [[ "${SELF_UPDATE_DRY_RUN}" == "1" ]]; then
      log_warn "dolibarr-source has local tracked changes; would skip checkout of ${remote_head}."
    else
      log_warn "dolibarr-source has local tracked changes; fetched remotes but skipped checkout of ${remote_head}."
    fi
    record_self_update_failure
    return 0
  fi

  log_step "Updating dolibarr-source detached HEAD to ${remote_head}"
  if ! run_or_dry git -C "${DOLIBARR_SOURCE_DIR}" checkout --detach "${remote_head}"; then
    log_warn "Could not move dolibarr-source to ${remote_head}."
    record_self_update_failure
  fi
}

update_core_worktrees() {
  local core
  local found=0

  shopt -s nullglob
  for core in "${CORES_DIR}"/dolibarr-*; do
    [[ -d "${core}" ]] || continue
    found=1
    update_git_branch_repo "${core}" "$(relpath "${core}")"
  done
  shopt -u nullglob

  if [[ "${found}" == "0" ]]; then
    log_warn "No Dolibarr core worktree found in ${CORES_DIR}."
    record_self_update_failure
  fi
}

cmd_self_update() {
  local arg

  SELF_UPDATE_DRY_RUN=0
  SELF_UPDATE_FAILURES=0

  for arg in "$@"; do
    case "${arg}" in
      --dry-run|-n)
        SELF_UPDATE_DRY_RUN=1
        ;;
      --help|-h)
        echo "Usage: ./client self-update [--dry-run]"
        echo "Updates this manager repository, Dolibarr source, and cores/dolibarr-* worktrees."
        return 0
        ;;
      *)
        log_error "Unknown self-update option: ${arg}"
        ;;
    esac
  done

  if [[ "${SELF_UPDATE_DRY_RUN}" == "1" ]]; then
    log_info "Dry-run mode enabled; no Git command will be executed."
  fi

  update_manager_repository
  update_dolibarr_source
  update_core_worktrees

  if [[ "${SELF_UPDATE_FAILURES}" -gt 0 ]]; then
    log_warn "Self-update finished with ${SELF_UPDATE_FAILURES} warning(s)."
  else
    log_success "Self-update completed."
  fi
}

# --- Commands ---

cmd="${1:-}"
client_arg="${2:-}"

case "${cmd}" in
  list)
    echo -e "${CYAN}Registered Clients:${NC}"
    printf "%-20s %-10s %-30s %-10s\n" "CLIENT" "VERSION" "URL" "STATUS"
    echo "--------------------------------------------------------------------------------"
    for cdir in "${CLIENTS_DIR}"/*; do
      if [[ -d "${cdir}" && -f "${cdir}/.env" ]]; then
        name=$(basename "${cdir}")
        version=$(grep "DOLI_CORE_PATH" "${cdir}/.env" | sed 's/.*dolibarr-\(.*\)\/htdocs.*/\1/')
        url=$(client_url "${name}")
        status=$(docker compose -f "${COMPOSE_FILE}" --env-file "${cdir}/.env" -p "${name}" ps --format "{{.State}}" 2>/dev/null | head -n1 || echo "stopped")
        [[ -z "$status" ]] && status="stopped"
        
        case "$status" in
          running) status_color="${GREEN}${status}${NC}" ;;
          *) status_color="${RED}${status}${NC}" ;;
        esac
        
        printf "%-20s %-10s %-30s %b\n" "${name}" "${version}" "${url}" "${status_color}"
      fi
    done
    ;;

  status)
    if [[ -n "${client_arg}" ]]; then
      dc "${client_arg}" ps
    else
      $0 list
    fi
    ;;

  create)
    # Interactive mode for client name
    client="${client_arg}"
    if [[ -z "${client}" ]]; then
      read -p "Client name (e.g. mycompany): " client
      [[ -z "${client}" ]] && log_error "Client name is required."
    fi

    # Check if exists
    CLIENT_DIR="${CLIENTS_DIR}/${client}"
    if [[ -d "${CLIENT_DIR}" ]]; then
      log_error "Client directory ${CLIENT_DIR} already exists."
    fi

    # Interactive mode for version
    doli_version="${3:-}"
    if [[ -z "${doli_version}" ]]; then
      echo -e "${YELLOW}Available Dolibarr versions:${NC}"
      versions=($(get_available_versions))
      for i in "${!versions[@]}"; do
        echo "  $((i+1))) ${versions[$i]}"
      done
      read -p "Select version [${versions[-1]}]: " ver_idx
      if [[ -z "${ver_idx}" ]]; then
        doli_version="${versions[-1]}"
      else
        doli_version="${versions[$((ver_idx-1))]}"
      fi
    fi

    # Validation version
    CORE_DIR="${CORES_DIR}/dolibarr-${doli_version}/htdocs"
    if [[ ! -d "${CORE_DIR}" ]]; then
      log_error "Dolibarr version ${doli_version} not found in ${CORES_DIR}"
    fi

    php_image="${4:-}"
    if [[ -z "${php_image}" ]]; then
      echo -e "${YELLOW}Common PHP versions:${NC}"
      php_versions=("7.4" "8.0" "8.1" "8.2" "8.3" "8.4")
      for i in "${!php_versions[@]}"; do echo "  $((i+1))) ${php_versions[$i]}"; done
      read -p "Select PHP version [8.4]: " php_idx
      if [[ -z "${php_idx}" ]]; then
        php_ver="8.4"
      else
        php_ver="${php_versions[$((php_idx-1))]}"
      fi
      php_image="$(default_php_image_for_version "${php_ver}")"
    fi

    log_info "Creating client ${NC}${PURPLE}${client}${NC} (Dolibarr ${doli_version}, PHP ${php_image})..."

    # --- Steps ---
    log_step "Step 1/7: Creating directories..."
    mkdir -p "${CLIENT_DIR}/"{conf,custom,db,documents,scripts}
    chmod 777 "${CLIENT_DIR}/documents" "${CLIENT_DIR}/conf" "${CLIENT_DIR}/custom" "${CLIENT_DIR}/scripts"
    touch "${CLIENT_DIR}/"{conf,custom,db,documents,scripts}/.gitkeep

    log_step "Step 2/7: Seeding documents directory..."
    ensure_documents_seeded "${client}"

    log_step "Step 3/7: Generating .env configuration..."
    cat <<EOF > "${CLIENT_DIR}/.env"
PROJECT=${client}
VHOST=${client}.local

# Paths relative to docker/compose.yml
DOLI_CORE_PATH=../cores/dolibarr-${doli_version}/htdocs
CLIENT_PATH=../clients/${client}

PHP_IMAGE=${php_image}

# Database Shared settings
DB_NAME=${client}_dolibarr
DB_USER=${client}_dolibarr
DB_PASS=$(openssl rand -hex 12)
DB_ROOT_PASS=root
EOF

    db_pass=$(grep '^DB_PASS=' "${CLIENT_DIR}/.env" | cut -d= -f2)
    vhost=$(grep '^VHOST=' "${CLIENT_DIR}/.env" | cut -d= -f2)

    log_step "Step 4/7: Initializing shared database..."
    db_up
    ensure_client_db "${client}_dolibarr" "${client}_dolibarr" "${db_pass}" "root"

    log_step "Step 5/7: Preparing install mode (skip conf.php pre-generation)..."
    # Keep conf.php absent so Dolibarr installer can start in clean "fresh install" mode.
    rm -f "${CLIENT_DIR}/conf/conf.php"
    generate_install_forced_php "${client}"

    log_step "Step 6/7: Configuring IDE (PHPStorm)..."
    mkdir -p "${CLIENT_DIR}/.idea"
    cat <<EOF > "${CLIENT_DIR}/.idea/modules.xml"
<?xml version="1.0" encoding="UTF-8"?>
<project version="4"><component name="ProjectModuleManager"><modules>
<module fileurl="file://\$PROJECT_DIR\$/.idea/${client}.iml" filepath="\$PROJECT_DIR\$/.idea/${client}.iml" />
</modules></component></project>
EOF
    cat <<EOF > "${CLIENT_DIR}/.idea/php.xml"
<?xml version="1.0" encoding="UTF-8"?>
<project version="4"><component name="PhpProjectSharedConfiguration" php_language_level="7.4"><option name="suggestChangeDefaultLanguageLevel" value="false" /></component></project>
EOF
    cat <<EOF > "${CLIENT_DIR}/.idea/${client}.iml"
<?xml version="1.0" encoding="UTF-8"?>
<module type="WEB_MODULE" version="4"><component name="NewModuleRootManager">
<content url="file://\$MODULE_DIR\$"><excludeFolder url="file://\$MODULE_DIR\$/documents" /></content>
<content url="file://\$MODULE_DIR\$/../../cores/dolibarr-${doli_version}"><sourceFolder url="file://\$MODULE_DIR\$/../../cores/dolibarr-${doli_version}" isTestSource="false" /></content>
<orderEntry type="inheritedJdk" /><orderEntry type="sourceFolder" forTests="false" /></component></module>
EOF

    log_step "Step 7/7: Updating /etc/hosts..."
    update_hosts "${vhost}"

    log_success "Client '${client}' is ready!"
    echo -e "\n${YELLOW}To finish setup:${NC}"
    echo -e "  1. Start stack:  ${CYAN}./client up ${client}${NC}"
    echo -e "  2. Installation: ${CYAN}$(client_url "${client}")install/${NC}"
    ;;

  up)
    [[ -n "${client_arg}" ]] || usage
    shared_infra_up
    ensure_documents_seeded "${client_arg}"
    sanitize_conf_for_install "${client_arg}"
    generate_install_forced_php "${client_arg}"
    dc "${client_arg}" up -d --remove-orphans "${@:3}"
    log_success "Environment is up: $(client_url "${client_arg}")"
    ;;

  down)
    [[ -n "${client_arg}" ]] || usage
    dc "${client_arg}" down --remove-orphans "${@:3}"
    ;;

  restart)
    [[ -n "${client_arg}" ]] || usage
    dc "${client_arg}" restart "${@:3}"
    ;;

  logs)
    [[ -n "${client_arg}" ]] || usage
    dc "${client_arg}" logs -f --tail=200 "${@:3}"
    ;;

  shell)
    [[ -n "${client_arg}" ]] || usage
    dc "${client_arg}" exec php bash "${@:3}"
    ;;

  url)
    [[ -n "${client_arg}" ]] || usage
    client_url "${client_arg}"
    ;;

  hosts)
    [[ -n "${client_arg}" ]] || usage
    env_file="$(need_client_env "${client_arg}")"
    vhost=$(grep -E '^VHOST=' "${env_file}" | cut -d= -f2)
    update_hosts "${vhost}"
    ;;


  restore)
    [[ -n "${client_arg}" ]] || usage
    env_file="$(need_client_env "${client_arg}")"
    CLIENT_DIR="${CLIENTS_DIR}/${client_arg}"
    
    # Read variables from .env
    DB_NAME=$(grep -E '^DB_NAME=' "${env_file}" | cut -d= -f2)
    DB_USER=$(grep -E '^DB_USER=' "${env_file}" | cut -d= -f2)
    DB_PASS=$(grep -E '^DB_PASS=' "${env_file}" | cut -d= -f2)
    DB_ROOT_PASS=$(grep -E '^DB_ROOT_PASS=' "${env_file}" | cut -d= -f2)

    dump_path="${3:-${CLIENTS_DIR}/${client_arg}/db/dump.sql.gz}"
    if [[ ! -f "${dump_path}" ]]; then
      if [[ -z "${3:-}" && -f "${CLIENTS_DIR}/${client_arg}/db/dump.sql" ]]; then
        dump_path="${CLIENTS_DIR}/${client_arg}/db/dump.sql"
      elif [[ -n "${3:-}" && "${3}" == *.gz && -f "${3%.gz}" ]]; then
        dump_path="${3%.gz}"
      elif [[ -n "${3:-}" && "${3}" != *.gz && -f "${3}.gz" ]]; then
        dump_path="${3}.gz"
      else
        log_error "Dump not found: ${dump_path}"
      fi
    fi

    db_up
    log_info "Cleaning and Restoring ${dump_path} into ${DB_NAME}..."

    # Reset database, then recreate the client account from .env (password included).
    db_exec -uroot -p"${DB_ROOT_PASS}" -e "DROP DATABASE IF EXISTS \`${DB_NAME}\`; CREATE DATABASE \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
    ensure_client_db "${DB_NAME}" "${DB_USER}" "${DB_PASS}" "${DB_ROOT_PASS}"

    SED_CMDS="s/utf8mb3/utf8mb4/g; s/utf8_unicode_ci/utf8mb4_unicode_ci/g; s/utf8_general_ci/utf8mb4_general_ci/g; s/CHARSET=utf8 /CHARSET=utf8mb4 /g; s/CHARSET=utf8;/CHARSET=utf8mb4;/g; s/CHARACTER SET utf8\([^m]\)/CHARACTER SET utf8mb4\1/g; s/DEFINER=[^ ]*//g; s/DEFINER=[^*]*\*/\*/g"

    if [[ "${dump_path}" == *.gz ]]; then
      (echo "SET FOREIGN_KEY_CHECKS=0; SET NAMES utf8mb4;"; gunzip -c "${dump_path}" | sed -e "${SED_CMDS}"; echo "SET FOREIGN_KEY_CHECKS=1;") | db_exec -uroot -p"${DB_ROOT_PASS}" "${DB_NAME}"
    else
      (echo "SET FOREIGN_KEY_CHECKS=0; SET NAMES utf8mb4;"; cat "${dump_path}" | sed -e "${SED_CMDS}"; echo "SET FOREIGN_KEY_CHECKS=1;") | db_exec -uroot -p"${DB_ROOT_PASS}" "${DB_NAME}"
    fi

    apply_sanitize_sql

    log_success "Database restored and sanitized."
    generate_conf_php "${client_arg}"
    log_info "Configuration file generated: ${CLIENT_DIR}/conf/conf.php"
    touch "${CLIENT_DIR}/documents/install.lock"
    chmod 664 "${CLIENT_DIR}/documents/install.lock"
    log_info "Install lock created."
    ;;
  
  sanitize)
    [[ -n "${client_arg}" ]] || usage
    env_file="$(need_client_env "${client_arg}")"

    DB_NAME=$(grep -E '^DB_NAME=' "${env_file}" | cut -d= -f2)
    DB_USER=$(grep -E '^DB_USER=' "${env_file}" | cut -d= -f2)
    DB_PASS=$(grep -E '^DB_PASS=' "${env_file}" | cut -d= -f2)

    db_up
    apply_sanitize_sql
    log_success "Database sanitized for '${client_arg}'."
    ;;

  config)
    [[ -n "${client_arg}" ]] || usage
    dc "${client_arg}" config
    ;;

  build)
    [[ -n "${client_arg}" ]] || usage
    dc "${client_arg}" build "${@:3}"
    ;;

  self-update)
    cmd_self_update "${@:2}"
    ;;

  completion)
    # Output bash completion script
    # To enable: source <(./client completion)
    cat <<EOF
_client_completion() {
    local cur prev opts
    COMPREPLY=()
    cur="\${COMP_WORDS[COMP_CWORD]}"
    prev="\${COMP_WORDS[COMP_CWORD-1]}"
    opts="list status create up down restart logs shell url hosts restore sanitize config build self-update completion"

    # Command completion
    if [[ \${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( \$(compgen -W "\${opts}" -- \${cur}) )
        return 0
    fi

    # Argument completion (clients)
    case "\${prev}" in
        up|down|restart|logs|shell|url|hosts|restore|sanitize|config|build|status)
            local clients_dir="./clients"
            if [[ -d "./clients" ]]; then
                local clients=\$(ls -1 "\${clients_dir}" 2>/dev/null)
                # Filter out hidden files/dirs if desired, usually ls doesn't show them without -a
                COMPREPLY=( \$(compgen -W "\${clients}" -- \${cur}) )
            fi
            return 0
            ;;
    esac
}
complete -F _client_completion ./client
complete -F _client_completion client
EOF
    ;;

  *)
    usage
    ;;
esac
